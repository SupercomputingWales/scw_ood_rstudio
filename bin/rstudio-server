#!/bin/bash

set -eu
MYPORT=8787

if [ $# -eq 1 ]
then
  MYPORT=$1
fi

echo "INFO: Server address is: `hostname`:$MYPORT"
if [ -n "${RSTUDIO_PASSWORD:-}" ]
then
  echo "INFO: Using environment variable RSTUDIO_PASSWORD"
  PASSWORD=$RSTUDIO_PASSWORD
else
  echo "INFO: Generating password."
  PASSWORD=`head /dev/urandom | tr -dc A-Za-z0-9 | head -c 13 ; echo ''`
fi

# Make sure we set only user permissions for temporary
MYOLDUMASK=`umask`
umask 0077

echo "INFO: Password to access site is: $PASSWORD"
SVRDATADIR="`mktemp -d`/$USER"
echo SVRDATADIR=$SVRDATADIR
COOKIE_KEY="$SVRDATADIR/rstudio-server/secure-cookie-key"
echo COOKIE_KEY=$COOKIE_KEY

TMPFILE=`mktemp`
chmod 700 $TMPFILE
cat > $TMPFILE <<EOF
#!/bin/bash
PASSWORD='$PASSWORD' RSTUDIO_SESSION_TIMEOUT='0' /usr/lib/rstudio-server/bin/rserver --auth-none=0  --auth-pam-helper-path=pam-helper --www-address=0.0.0.0 --www-port=$MYPORT --server-data-dir=$SVRDATADIR --secure-cookie-key-file=$COOKIE_KEY --auth-encrypt-password=0 --server-set-umask=0 --server-user=$USER
EOF

RSTUDIO_DB=`mktemp -d`
echo RSTUDIO_DB=$RSTUDIO_DB

MYRSTUDIO_LIB=$HOME/R-Rstudio
if [ ! -d $MYRSTUDIO_LIB ]
then
  echo "INFO: Creating $MYRSTUDIO_LIB to use as ~/R"
  mkdir $MYRSTUDIO_LIB
fi

[ -d $HOME/R ] || mkdir $HOME/R

MYRSTUDIO_LIB=$(readlink -f $MYRSTUDIO_LIB)
MYR_LIB=$(readlink -f $HOME/R)

# get user project scratch directories and mount them into RStudio container
set +u
for project in `/usr/bin/id $USER | /usr/bin/grep -o 'SCWF[0-9]*'`; do
    echo $project
    project_dirs=/scratch/$project,$project_dirs
done
project_dirs=`echo $project_dirs | sed 's/,$//'`
set -u

export APPTAINER_BIND=$RSTUDIO_DB:/var/lib/rstudio-server,$MYRSTUDIO_LIB:$MYR_LIB,/sys/fs/cgroup,$project_dirs

# Check if we use job specific Renviron.
if [ -n "${MYRENVIRON:-}" ]
then
  echo "INFO: Creating temporary .Renviron to use local settings."
  ABSRENVIRON=$(readlink -f $HOME/.Renviron)
  export APPTAINER_BIND="$APPTAINER_BIND,$MYRENVIRON:$ABSRENVIRON"
fi
# Switch back to original before running.
umask $MYOLDUMASK
echo "INFO: About to run $TMPFILE with umask `umask`"
exec apptainer exec --nv $RSTUDIO_IMAGE $TMPFILE 
